---
import Layout from "../layouts/Layout.astro";

const workshop = {
  title: "Total Recall",
  subtitle: "AI for Lifelong Memory",
  tagline:
    "This workshop focuses on lifelong, evolving memory at the scale of terabytes to petabytes of artifacts per coherent context, corresponding to decades of human digital activity.",
};

const researchQuestions = [
  "Which scaling dimensions most affect lifelong-memory performance — text or multimodal data volume, time span, time resolution of experience, diversity of user preferences and experiences, or more?",
  "Which representations can retain a lifetime of memories while supporting efficient updates and recall?",
  "How can we construct realistic, personalized, lifelong memory datasets?",
  "Which tasks and metrics should a lifelong memory benchmark prioritize: retaining details; consolidation and abstraction; abstention; grounding; associative and multi-hop recall; cost and latency of encoding, updating, and recall; or interpretability and editability?",
  "Which requirements do memory for agents and memory for human assistance share, and which differ?",
  "How should we measure memory assistance for people, including improved recollection, reduced effort, surfacing forgotten memories, and more?",
];

const speakers = [
  { name: "Jeff Clune", affiliation: "UBC · Recursive AI", image: "/speaker-jeff-clune.jpg", link: "https://www.cs.ubc.ca/people/jeff-clune" },
  { name: "Charles Fan", affiliation: "MemVerge", image: "/speaker-charles-fan.jpg", link: "https://www.linkedin.com/in/charlesfan1/" },
  { name: "Emily B. Fox", affiliation: "Stanford · insitro", image: "/speaker-emily-fox.jpg", link: "https://emilybfox.su.domains/" },
  { name: "Weiwen Liu", affiliation: "Shanghai Jiao Tong University", image: "/speaker-weiwen-liu.png", link: "https://wwliu555.github.io" },
  { name: "Spandan Madan", affiliation: "Engramme", image: "/spandan-default.jpg", link: "https://www.linkedin.com/in/spandan-madan-337b6820b/" },
  { name: "Tsendsuren Munkhdalai", affiliation: "Google DeepMind", image: "/speaker-tsendsuren-munkhdalai.jpg", link: "http://www.tsendeemts.com/" },
  { name: "Diyi Yang", affiliation: "Stanford", image: "/speaker-diyi-yang.jpg", link: "https://cs.stanford.edu/people/diyi-yang" },
  { name: "Jie Zheng", affiliation: "UC Davis", image: "/speaker-jie-zheng.jpg", link: "https://health.ucdavis.edu/neurological-surgery/team/43431/jie-jz-zheng" },
];

const schedule = [
  { time: "8:00 – 8:10", duration: "10 min", session: "Opening remarks and framing" },
  { time: "8:10 – 9:50", duration: "100 min", session: "Morning invited session — 4 × (20-minute talk + 5-minute Q&A)" },
  { time: "9:50 – 10:20", duration: "30 min", session: "Coffee break and informal discussion" },
  { time: "10:20 – 10:35", duration: "15 min", session: "Contributed spotlight — 12-minute talk + 3-minute Q&A" },
  { time: "10:35 – 11:35", duration: "60 min", session: "Contributed talks — 5 × (10-minute presentation + 2-minute Q&A)" },
  { time: "11:35 – 12:35", duration: "60 min", session: "Debate: general-purpose AI agents versus specialized memory algorithms" },
  { time: "12:35 – 1:50", duration: "75 min", session: "Lunch and informal exchange" },
  { time: "1:50 – 3:30", duration: "100 min", session: "Afternoon invited session — 4 × (20-minute talk + 5-minute Q&A)" },
  { time: "3:30 – 4:00", duration: "30 min", session: "Coffee break and informal discussion" },
  { time: "4:00 – 5:30", duration: "90 min", session: "Poster session" },
  { time: "5:30 – 6:00", duration: "30 min", session: "Moderated panel to synthesize workshop topics" },
];

const relatedWorkshops = [
  "New Frontiers in Associative Memories (NFAM; NeurIPS 2023, ICLR 2025, ICLR 2026)",
  "Long-Context Foundation Models (LCFM; ICML 2025, NeurIPS 2026)",
  "Memory for LLM-Based Agentic Systems (MemAgents; ICLR 2026)",
  "Lifelong Agents (ICLR 2026; COLM 2026)",
  "Context Beyond the Window (COLM 2026)",
  "Personalized, Aligned, Long-term Memory for AI systems (PALM; NeurIPS 2026)",
];

const references = [
  "Xiao, W., Deshpande, S., Mahesh, G., Madan, S., & Kreiman, G. (2026). Memory is Not Search: Towards Proactive, Lifelong Memory in AI. NeurIPS 2026, Position Paper Track (accepted).",
  "Tran, A., et al. (2025). The State-of-the-Art in Lifelog Retrieval: A Review of Progress at the ACM Lifelog Search Challenge Workshop 2022–2024. IEEE Access 13: 216340–216363.",
  "Gemmell, J., Bell, G., & Lueder, R. (2006). MyLifeBits: a personal database for everything. Communications of the ACM 49(1): 88–95.",
  "Hendrycks, D., et al. (2025). A definition of AGI. arXiv:2510.18212.",
  "Maharana, A., et al. (2024). Evaluating very long-term conversational memory of LLM agents. ACL 2024.",
  "Wu, D., et al. (2024). LongMemEval: Benchmarking chat assistants on long-term interactive memory. arXiv:2410.10813.",
  "Tavakoli, M., et al. (2026). Beyond a million tokens: Benchmarking and enhancing long-term memory in LLMs. ICLR 2026.",
];

const organizers = [
  { name: "Gabriel Kreiman", affiliation: "Engramme · Harvard", email: "gabriel@engramme.com", image: "/gabriel-default.jpg", link: "https://kreimanlab.com" },
  { name: "Will Xiao", affiliation: "Engramme", email: "will@engramme.com", image: "/will-default.jpg", link: "https://www.linkedin.com/in/will-xiao-38915656/" },
  { name: "Mengmi Zhang", affiliation: "Nanyang Technological University", email: "mengmi.zhang@ntu.edu.sg", image: "/speaker-mengmi-zhang.png", link: "https://www.a-star.edu.sg/cfar/about-cfar/our-team/dr-zhang-mengmi" },
];
---

<Layout>
  <section class="bg-surface-page px-[36px] md:px-[56px] lg:px-[112px] pt-[10vh] pb-[40px] md:pb-[56px]">
    <div class="mx-auto w-full max-w-[1272px] flex flex-col md:flex-row items-start md:items-center justify-center xl:justify-between gap-[36px] xl:gap-[55px]">
      <div class="flex flex-col items-start gap-[28px] xl:gap-[40px] w-full md:flex-1 md:min-w-0 md:max-w-[488px]">
        <div class="flex flex-col items-start gap-[12px] w-full">
          <h1 class="font-dm-sans text-text-heading text-h1 xl:text-display-md xl:font-medium tracking-[-0.4px] lg:tracking-[-0.6px] xl:tracking-[-3px]">
            {workshop.title}
          </h1>
          <h2 class="font-dm-sans font-medium text-text-heading text-h5">
            {workshop.subtitle}
          </h2>
        </div>
        <p class="font-dm-sans text-text-heading text-body-md xl:text-body-lg tracking-[-0.07px] xl:tracking-normal max-w-[500px]">
          {workshop.tagline}
        </p>
        <span
          class="inline-flex items-center px-6 py-2 md:py-3 rounded-xl bg-black/5 text-[#787270] text-body-md md:text-xl font-dm-sans font-medium md:font-semibold border border-[#d2d0d0] cursor-not-allowed select-none"
          aria-disabled="true"
        >
          Registration opens soon
        </span>
      </div>
      <div class="w-full md:flex-1 md:max-w-[707px] aspect-[707/552] rounded-[16px] overflow-hidden flex-shrink-0">
        <img src="/Images/workshop-memory.webp" alt="" class="w-full h-full object-cover select-none" draggable="false" />
      </div>
    </div>
  </section>

  <nav class="sticky top-0 z-30 bg-surface-page/90 backdrop-blur-sm border-y border-[#d2d0d0]">
    <div class="w-full max-w-[1272px] mx-auto overflow-x-auto no-scrollbar">
      <div class="w-max mx-auto flex items-center gap-[28px] md:gap-[36px] px-[36px] md:px-[56px] lg:px-[112px] py-[16px] whitespace-nowrap text-body-md font-dm-sans tracking-[-0.08px]">
        <a href="#about" class="text-text-body hover:text-text-heading transition-colors">Overview</a>
        <a href="#why-now" class="text-text-body hover:text-text-heading transition-colors">Why now</a>
        <a href="#topics" class="text-text-body hover:text-text-heading transition-colors">Research questions</a>
        <a href="#speakers" class="text-text-body hover:text-text-heading transition-colors">Speakers</a>
        <a href="#agenda" class="text-text-body hover:text-text-heading transition-colors">Agenda</a>
        <a href="#debate" class="text-text-body hover:text-text-heading transition-colors">Debate</a>
        <a href="#papers" class="text-text-body hover:text-text-heading transition-colors">Papers</a>
        <a href="#organizers" class="text-text-body hover:text-text-heading transition-colors">Organizers</a>
        <a href="#related" class="text-text-body hover:text-text-heading transition-colors">Related</a>
        <a href="#references" class="text-text-body hover:text-text-heading transition-colors">References</a>
      </div>
    </div>
  </nav>

  <section id="about" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-surface-page scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Overview</h2>
      <div class="flex flex-col gap-[20px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <p>This workshop focuses on lifelong, evolving memory at the scale of terabytes to petabytes of artifacts per coherent context, corresponding to decades of human digital activity. How to represent evolving memory at the human lifelong scale is a vital gap precluding current AI from achieving key aspects of human-level intelligence. AI that can handle a lifetime of memories also promises to alleviate devastating conditions of memory loss and even augment human memory.</p>
        <p>Memory at the human lifelong scale extends well beyond today's chatbot conversations, agent traces, and agent memory benchmarks, and poses particular challenges: multiscale consolidation of experience, preserving details through repeated consolidations, retaining rarely used evidence, distinguishing similar events, handling evolving facts and preferences, and cost-efficient encoding, updates, and recall. AI that augments human memory should improve assisted recollection, reduce effort in organizing documents and files, and surface forgotten memories that inform present decisions.</p>
        <p>By convening experts in agentic memory, context management, long-context models, continual and lifelong learning, personalized AI, human–computer interaction, and the cognitive neuroscience of memory, we aim to shape a coherent framework and design adequate benchmarks for advancing lifelong AI memory.</p>
      </div>
    </div>
  </section>

  <section id="why-now" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-bg-secondary scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Why now</h2>
      <div class="flex flex-col gap-[20px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <p>Memory at the human lifelong scale is gaining relevance with burgeoning interest in AI that can do economically valuable human-level work and in personal AI assistants. Long-term memory remains a key challenge in the quest for AGI.</p>
        <p>Approaches to represent and use memory remain fragmentary: retrieval-augmented generation, agent-managed tools and notes, long-context, recurrent, and state-space architectures, context compression and latent context, post-deployment and test-time training and fine-tuning, hypernetworks, and beyond.</p>
        <p>There are few datasets and benchmarks for human-like memory at the lifelong scale, which must test deep, realistic, grounded experience and evolving environments and needs across years, well beyond small contexts and synthetic datasets.</p>
      </div>
    </div>
  </section>

  <section id="topics" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-surface-page scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Research questions</h2>
      <div class="flex flex-col gap-[20px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <ul class="flex flex-col gap-[16px] list-disc pl-[20px]">
          {researchQuestions.map((q) => (
            <li>{q}</li>
          ))}
        </ul>
        <p class="mt-[12px]">We will publish a public synthesis of the debate and closing panel as a research agenda recording points of agreement and disagreement; a draft benchmark specification covering data units, tasks, metrics, and costs; and open questions. Contributions will be invited from panelists, debaters, and authors of relevant contributed work.</p>
      </div>
    </div>
  </section>

  <section id="speakers" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-bg-secondary scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto">
      <div class="flex flex-col gap-[12px] mb-[36px]">
        <h2 class="text-h3 font-dm-sans text-text-heading">Invited speakers</h2>
        <p class="text-body-md font-dm-sans text-text-body-light max-w-[700px]">All eight speakers confirmed.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-[24px] md:gap-[32px]">
        {speakers.map((speaker) => (
          speaker.link ? (
            <a href={speaker.link} target="_blank" rel="noopener noreferrer" class="flex flex-col gap-[12px] group">
              <div class="w-full aspect-square rounded-[12px] bg-bg-secondary overflow-hidden flex items-center justify-center">
                <img src={speaker.image} alt={speaker.name} class="w-full h-full object-cover" />
              </div>
              <div class="flex flex-col gap-[4px]">
                <h3 class="text-h6 font-dm-sans font-medium text-text-heading">{speaker.name}</h3>
                <p class="text-body-md font-dm-sans text-text-body-light tracking-[-0.08px]">{speaker.affiliation}</p>
              </div>
            </a>
          ) : (
            <div class="flex flex-col gap-[12px]">
              <div class="w-full aspect-square rounded-[12px] bg-bg-secondary overflow-hidden flex items-center justify-center">
                <img src={speaker.image} alt={speaker.name} class="w-full h-full object-cover" />
              </div>
              <div class="flex flex-col gap-[4px]">
                <h3 class="text-h6 font-dm-sans font-medium text-text-heading">{speaker.name}</h3>
                <p class="text-body-md font-dm-sans text-text-body-light tracking-[-0.08px]">{speaker.affiliation}</p>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <section id="agenda" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-surface-page scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Schedule</h2>
      <div class="flex flex-col flex-1 max-w-[800px]">
        {schedule.map((slot) => (
          <div class="flex flex-col md:flex-row gap-[8px] md:gap-[32px] py-[16px] border-b border-[#d2d0d0] first:border-t">
            <div class="flex flex-col md:w-[160px] flex-shrink-0">
              <p class="text-body-md font-dm-sans font-medium text-text-heading tracking-[-0.08px]">{slot.time}</p>
              <p class="text-body-sm font-dm-sans text-text-body-light">{slot.duration}</p>
            </div>
            <p class="text-body-md font-dm-sans text-text-body flex-1 leading-[24px]">{slot.session}</p>
          </div>
        ))}
        <p class="text-body-md font-dm-sans italic text-text-body-light mt-[20px]">Tentative schedule, subject to final conference scheduling.</p>
      </div>
    </div>
  </section>

  <section id="debate" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-bg-secondary scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Debate and panel</h2>
      <div class="flex flex-col gap-[24px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <div class="flex flex-col gap-[8px]">
          <h3 class="text-h6 font-dm-sans font-medium text-text-heading">Debate question</h3>
          <p>Can general-purpose AI agents using today's tools, including computer use, solve lifelong memory tasks without further specialized memory algorithms?</p>
        </div>
        <div class="flex flex-col gap-[8px]">
          <h3 class="text-h6 font-dm-sans font-medium text-text-heading">Panel topic</h3>
          <p>What are the biggest challenges when extending memory from individual tasks to years of experience? What experiment would distinguish competing approaches to each challenge?</p>
        </div>
        <p>We will collect audience questions and benchmark proposals before and during the workshop. The closing panel will synthesize a benchmark proposal and identify unresolved disagreements for the post-workshop article.</p>
      </div>
    </div>
  </section>

  <section id="papers" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-surface-page scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Contributed work</h2>
      <div class="flex flex-col gap-[20px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <p>Alongside full papers, we are establishing a dedicated short-paper track for 3–5 page small, self-contained results, replications, reanalyses, and negative results. This track supports late-breaking work and participation by new, under-represented, or under-resourced authors.</p>
        <div class="flex flex-col gap-[8px] py-[16px] border-y border-[#d2d0d0]">
          <div class="flex flex-col md:flex-row md:gap-[32px]">
            <p class="text-body-md font-dm-sans font-medium text-text-heading md:w-[160px] flex-shrink-0 tracking-[-0.08px]">Submissions due</p>
            <p>February 1, 2027</p>
          </div>
          <div class="flex flex-col md:flex-row md:gap-[32px]">
            <p class="text-body-md font-dm-sans font-medium text-text-heading md:w-[160px] flex-shrink-0 tracking-[-0.08px]">Notifications</p>
            <p>February 26, 2027</p>
          </div>
        </div>
        <p>Paper submissions and reviews must be primarily human-authored. The Call for Papers requires authors to attest that submissions are not already published in a peer-reviewed venue. Workshop submissions are non-archival.</p>
      </div>
    </div>
  </section>

  <section id="organizers" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-bg-secondary scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto">
      <h2 class="text-h3 font-dm-sans text-text-heading mb-[36px]">Organizers</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-[32px] md:gap-[36px] items-start max-w-[1000px]">
        {organizers.map((person) => (
          <div class="flex flex-col gap-[12px]">
            {person.link ? (
              <a href={person.link} target="_blank" rel="noopener noreferrer" class="flex flex-col gap-[12px] group">
                <div class="w-full aspect-square rounded-[12px] overflow-hidden bg-bg-secondary">
                  <img src={person.image} alt={person.name} class="w-full h-full object-cover" />
                </div>
                <h3 class="text-h6 font-dm-sans font-medium text-text-heading">{person.name}</h3>
              </a>
            ) : (
              <>
                <div class="w-full aspect-square rounded-[12px] overflow-hidden bg-bg-secondary">
                  <img src={person.image} alt={person.name} class="w-full h-full object-cover" />
                </div>
                <h3 class="text-h6 font-dm-sans font-medium text-text-heading">{person.name}</h3>
              </>
            )}
            <p class="text-body-md font-dm-sans text-text-body-light tracking-[-0.08px]">{person.affiliation}</p>
            <a href={`mailto:${person.email}`} class="text-body-md font-dm-sans text-text-body underline">{person.email}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="related" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-surface-page scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">Related workshops</h2>
      <div class="flex flex-col gap-[20px] flex-1 max-w-[800px] text-body-md font-dm-sans text-text-body leading-[26px]">
        <ul class="flex flex-col gap-[12px] list-disc pl-[20px]">
          {relatedWorkshops.map((w) => (
            <li>{w}</li>
          ))}
        </ul>
        <p class="mt-[12px]">This workshop is distinguished by its focus on human-lifetime-scale memory of terabytes to petabytes of digital data per coherent context and on human memory augmentation. This combination poses distinct questions about memory capacity; encoding, update, and recall costs; personalization, alignment, and learning; proactivity; and human-centric evaluation.</p>
      </div>
    </div>
  </section>

  <section id="references" class="px-[36px] md:px-[56px] lg:px-[112px] py-[72px] md:py-[96px] bg-bg-secondary scroll-mt-[72px]">
    <div class="w-full max-w-[1272px] mx-auto flex flex-col lg:flex-row gap-[48px] lg:gap-[104px] items-start">
      <h2 class="text-h3 font-dm-sans text-text-heading w-full lg:w-[300px] lg:flex-shrink-0">References</h2>
      <div class="flex flex-col gap-[12px] flex-1 max-w-[800px] text-body-sm font-dm-sans text-text-body leading-[22px]">
        <ol class="flex flex-col gap-[12px] list-decimal pl-[20px]">
          {references.map((r) => (
            <li>{r}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="relative flex flex-col gap-[24px] h-[420px] md:h-[500px] items-center justify-center px-[36px] md:px-[80px] lg:px-[112px] py-[60px] md:py-[80px] w-screen">
    <img src="/gradient-bg.png" alt="" class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
    <div class="relative flex flex-col gap-[16px] items-center w-full max-w-[900px]">
      <h2 class="text-h6 font-dm-sans text-text-heading text-center">Questions?</h2>
    </div>
    <div class="relative flex flex-col gap-[16px] items-center w-full max-w-[900px]">
      <h2 class="text-h3 font-dm-sans font-semibold text-text-heading text-center">Reach out to the organizers.</h2>
    </div>
    <a href="#organizers" class="relative flex gap-[12px] items-center justify-center px-[24px] py-[12px] rounded-full border border-black">
      <span class="font-dm-sans text-[20px] leading-[33px] font-semibold text-black">Contact organizers</span>
    </a>
  </section>
</Layout>

<style>
  .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
